---
// src/components/FichaProducto.astro
interface Props {
  id: string;
  marca: string;
  modelo: string;
  precio: number;
  imagen: string;
  categoria: string;
  talles: string[]; // Recibimos un array, no un string
  colores: string[]; // Array de colores (Hex o nombres)
  estado?: string;
  precioOferta?: number | null;
}

const { id, marca, modelo, precio, imagen, categoria, talles, colores, estado, precioOferta } = Astro.props;

// Formateador de moneda (para que se vea como $ 150.000)
const precioFormateado = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: 'ARS',
  minimumFractionDigits: 0
}).format(precio);

const precioOfertaFormateado = precioOferta ? new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: 'ARS',
  minimumFractionDigits: 0
}).format(precioOferta) : null;

const productUrl = import.meta.env.BASE_URL + "producto/" + id;
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition-all hover:shadow-lg">
  <div class="relative aspect-square overflow-hidden bg-gray-100">
    <a href={productUrl}>
      <img 
        src={imagen} 
        alt={`${marca} ${modelo}`} 
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </a>
    <div class="absolute top-5 left-5 flex flex-col gap-1 items-start pointer-events-none">
      
      {estado && (
        <span class="rounded-md bg-orange-500 px-2 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-sm">
          {estado}
        </span>
      )}
    </div>
  </div>

  <div class="flex flex-1 flex-col p-4">
    <p class="mb-1 text-xs font-semibold uppercase text-gray-500">{marca}</p>
    <h3 class="mb-2 text-lg font-bold text-gray-900 leading-tight">
      <a href={productUrl} class="hover:text-orange-600 transition-colors">
        {modelo}
      </a>
    </h3>

    <div class="mb-4 flex items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1">
        {talles.slice(0, 4).map((talle) => (
          <span class="flex h-6 w-6 items-center justify-center rounded border border-gray-200 text-[10px] text-gray-600">
            {talle}
          </span>
        ))}
        {talles.length > 4 && <span class="text-xs text-gray-400">+</span>}
      </div>
      <div class="flex gap-1">
        {colores.map((c) => (
          <div 
            class="h-5 w-5 rounded-full border border-gray-200 shadow-sm" 
            style={`background-color: ${c}`} 
            title={c}
          ></div>
        ))}
      </div>
    </div>

    <div class="mt-auto flex items-center justify-between border-t border-gray-100 pt-3">
      <div>
        {precioOferta && precioOferta > 0 ? (
          <div class="flex items-baseline gap-x-2">
            <p class="text-xl font-bold text-orange-600">{precioOfertaFormateado}</p>
            <p class="text-sm text-gray-500 line-through">{precioFormateado}</p>
          </div>
        ) : (
          <p class="text-xl font-bold text-gray-900">{precioFormateado}</p>
        )}
      </div>
      <a href={productUrl} class="rounded-lg bg-black p-2 text-white transition-colors hover:bg-gray-800" aria-label={`Ver ${marca} ${modelo}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
      </a>
    </div>
  </div>
</article>