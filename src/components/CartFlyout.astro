---
// src/components/CartFlyout.astro
---

<div id="cartFlyout" class="fixed inset-0 z-[60] hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
  <!-- Fondo oscuro -->
  <div id="cartBackdrop" class="fixed inset-0 bg-black/30 backdrop-blur-sm transition-opacity opacity-0"></div>

  <div class="fixed inset-0 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
        <div id="cartPanel" class="pointer-events-auto w-screen max-w-md transform transition ease-in-out duration-500 translate-x-full sm:duration-700">
          <div class="flex h-full flex-col overflow-y-scroll bg-white shadow-xl">
            <div class="flex-1 overflow-y-auto px-4 py-6 sm:px-6">
              <div class="flex items-start justify-between">
                <h2 class="text-lg font-medium text-gray-900" id="slide-over-title">Tu Carrito</h2>
                <div class="ml-3 flex h-7 items-center">
                  <button id="closeCartBtn" type="button" class="relative -m-2 p-2 text-gray-400 hover:text-gray-500 cursor-pointer">
                    <span class="absolute -inset-0.5"></span>
                    <span class="sr-only">Cerrar panel</span>
                    <i class="ph ph-x text-2xl"></i>
                  </button>
                </div>
              </div>

              <div class="mt-8">
                <div class="flow-root">
                  <ul id="cartItemsList" role="list" class="-my-6 divide-y divide-gray-200">
                    <!-- Los items se inyectarán aquí con JS -->
                  </ul>
                  <div id="emptyCartMessage" class="hidden py-10 text-center text-gray-500">
                    <i class="ph ph-shopping-cart text-4xl mb-2 block"></i>
                    Tu carrito está vacío.
                  </div>
                </div>
              </div>
            </div>

            <div class="border-t border-gray-200 px-4 py-6 sm:px-6">
              <div class="flex justify-between text-base font-medium text-gray-900">
                <p>Subtotal</p>
                <p id="cartTotal">$0</p>
              </div>
              <p class="mt-0.5 text-sm text-gray-500">Envío calculado al confirmar por WhatsApp.</p>
              <div class="mt-6">
                <a id="checkoutBtn" href="#" target="_blank" class="flex items-center justify-center rounded-md border border-transparent bg-orange-600 px-6 py-3 text-base font-medium text-white shadow-sm hover:bg-orange-700">
                  <i class="ph ph-whatsapp-logo text-xl mr-2"></i>
                  Finalizar Pedido
                </a>
              </div>
              <div class="mt-6 flex justify-center text-center text-sm text-gray-500">
                <p>
                  o
                  <button id="continueShoppingBtn" type="button" class="font-medium text-orange-600 hover:text-orange-500 cursor-pointer">
                    Continuar Comprando
                    <span aria-hidden="true"> &rarr;</span>
                  </button>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  // Lógica del Carrito (Client-side)
  const cartFlyout = document.getElementById('cartFlyout');
  const cartBackdrop = document.getElementById('cartBackdrop');
  const cartPanel = document.getElementById('cartPanel');
  const closeCartBtn = document.getElementById('closeCartBtn');
  const continueShoppingBtn = document.getElementById('continueShoppingBtn');
  const cartItemsList = document.getElementById('cartItemsList');
  const cartTotalElement = document.getElementById('cartTotal');
  const emptyCartMessage = document.getElementById('emptyCartMessage');
  const checkoutBtn = document.getElementById('checkoutBtn');

  let cart = JSON.parse(localStorage.getItem('gambaCart') || '[]');

  function toggleCart(show) {
    if (show) {
      cartFlyout?.classList.remove('hidden');
      // Pequeño delay para permitir la transición CSS
      setTimeout(() => {
        cartBackdrop?.classList.remove('opacity-0');
        cartPanel?.classList.remove('translate-x-full');
      }, 10);
      renderCart();
    } else {
      cartBackdrop?.classList.add('opacity-0');
      cartPanel?.classList.add('translate-x-full');
      setTimeout(() => {
        cartFlyout?.classList.add('hidden');
      }, 500);
    }
  }

  function updateCartStorage() {
    localStorage.setItem('gambaCart', JSON.stringify(cart));
    renderCart();
    // Disparar evento para actualizar contador en Navbar
    window.dispatchEvent(new Event('cartUpdated'));
  }

  function removeItem(index) {
    cart.splice(index, 1);
    updateCartStorage();
  }

  function updateQuantity(index, change) {
    if (cart[index].quantity + change > 0) {
      cart[index].quantity += change;
      updateCartStorage();
    }
  }

  function renderCart() {
    if (!cartItemsList || !cartTotalElement || !emptyCartMessage || !checkoutBtn) return;

    cartItemsList.innerHTML = '';
    let total = 0;

    if (cart.length === 0) {
      emptyCartMessage.classList.remove('hidden');
    } else {
      emptyCartMessage.classList.add('hidden');
      
      cart.forEach((item, index) => {
        total += item.price * item.quantity;
        const li = document.createElement('li');
        li.className = 'flex py-6';
        li.innerHTML = `
          <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-md border border-gray-200">
            <img src="${item.image}" alt="${item.name}" class="h-full w-full object-cover object-center">
          </div>
          <div class="ml-4 flex flex-1 flex-col">
            <div>
              <div class="flex justify-between text-base font-medium text-gray-900">
                <h3><a href="#">${item.name}</a></h3>
                <p class="ml-4">$${item.price.toLocaleString('es-AR')}</p>
              </div>
              <p class="mt-1 text-sm text-gray-500">${item.brand}</p>
              <div class="mt-1 flex gap-2 text-sm text-gray-500">
                ${item.size ? `<span class="bg-gray-100 px-2 py-0.5 rounded">Talle: ${item.size}</span>` : ''}
                ${item.color ? `<span class="bg-gray-100 px-2 py-0.5 rounded flex items-center gap-1"><span class="w-3 h-3 rounded-full border border-gray-300" style="background-color:${item.color}"></span>Color</span>` : ''}
              </div>
            </div>
            <div class="flex flex-1 items-end justify-between text-sm">
              <div class="flex items-center border border-gray-300 rounded-md">
                <button type="button" class="px-2 py-0.5 text-gray-600 hover:bg-gray-100 decrease-qty-btn cursor-pointer" data-index="${index}">-</button>
                <span class="px-2 text-gray-900 font-medium min-w-[1.5rem] text-center">${item.quantity}</span>
                <button type="button" class="px-2 py-0.5 text-gray-600 hover:bg-gray-100 increase-qty-btn cursor-pointer" data-index="${index}">+</button>
              </div>
              <button type="button" class="font-medium text-orange-600 hover:text-orange-500 remove-btn cursor-pointer" data-index="${index}">Eliminar</button>
            </div>
          </div>
        `;
        cartItemsList.appendChild(li);
      });

      // Agregar listeners a los botones de eliminar
      document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt(e.currentTarget.dataset.index || '0');
          removeItem(idx);
        });
      });

      document.querySelectorAll('.decrease-qty-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt(e.currentTarget.dataset.index || '0');
          updateQuantity(idx, -1);
        });
      });

      document.querySelectorAll('.increase-qty-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt(e.currentTarget.dataset.index || '0');
          updateQuantity(idx, 1);
        });
      });
    }

    cartTotalElement.textContent = `$${total.toLocaleString('es-AR')}`;

    // Generar link de WhatsApp
    const message = "Hola Gamba Store! Quiero realizar el siguiente pedido:\n\n" + 
      cart.map((i) => `- ${i.brand} ${i.name} (${i.size || 'N/A'}, ${i.color || 'N/A'}) x${i.quantity} - $${(i.price * i.quantity).toLocaleString('es-AR')}`).join('\n') +
      `\n\n*Total: $${total.toLocaleString('es-AR')}*`;
    
    checkoutBtn.href = `https://wa.me/5493764102637?text=${encodeURIComponent(message)}`;
  }

  // Event Listeners
  closeCartBtn?.addEventListener('click', () => toggleCart(false));
  cartBackdrop?.addEventListener('click', () => toggleCart(false));
  continueShoppingBtn?.addEventListener('click', () => toggleCart(false));

  // Escuchar evento personalizado para abrir carrito
  window.addEventListener('openCart', () => toggleCart(true));
  
  // Escuchar evento para agregar items (desde otras páginas)
  window.addEventListener('addToCart', (e) => {
    const newItem = e.detail;
    const existingItemIndex = cart.findIndex((item) => 
      item.id === newItem.id && 
      item.size === newItem.size && 
      item.color === newItem.color
    );
    if (existingItemIndex > -1) {
      cart[existingItemIndex].quantity += newItem.quantity;
    } else {
      cart.push(newItem);
    }
    updateCartStorage();
    toggleCart(true);
  });
</script>
